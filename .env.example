# Required
SPOOLMAN_URL=http://spoolman.example:7912
MOONRAKER_URL=http://printer.example:7125

# Optional (defaults shown)
MOONRAKER_API_KEY=
SLOT_LOCATIONS=QIDI Box Slot 1,QIDI Box Slot 2,QIDI Box Slot 3,QIDI Box Slot 4
POLL_INTERVAL=30
DEFER_WHILE_PRINTING=true
MATERIAL_ALIASES={"PLA+": "PLA", "PLA PLUS": "PLA", "PETG+": "PETG"}
STATE_FILE=/data/state.json
DRY_RUN=false
LOG_LEVEL=INFO
